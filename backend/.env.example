PORT=3001
# Required in production: ≥32 random characters. Dev fallback is insecure.
JWT_SECRET=change-this-to-a-long-random-string-in-production
# Production defaults to 7d when unset. "never" is only allowed in local development.
# JWT_EXPIRES_IN=7d

# Production bootstrap for Super Admin (recommended on Railway).
# SUPER_ADMIN_EMAIL defaults to admin@ninjaera.com — keep SEED_ADMIN_EMAIL in sync.
# SUPER_ADMIN_EMAIL=admin@ninjaera.com
# SEED_ADMIN_EMAIL=admin@ninjaera.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_USERNAME=admin

# ── Database provider ───────────────────────────────────────────────────────
# sqlite (default, local development) | postgres (Railway / production)
DATABASE_PROVIDER=sqlite
# SQLite file path (ignored when DATABASE_PROVIDER=postgres)
DATABASE_PATH=./data/ninja-era.db
# Optional override for data directory (backups, local uploads default)
# DATA_DIR=./data

# PostgreSQL (required when DATABASE_PROVIDER=postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/ninja_era
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=10

# ── File storage provider ───────────────────────────────────────────────────
# local (dev only) | cloudinary (recommended on Railway) | s3/r2 (large game builds)
STORAGE_PROVIDER=local
# Local upload directory (defaults to <DATA_DIR>/uploads when unset) — NOT durable on Railway
UPLOAD_DIR=./uploads

# Cloudinary (recommended for Railway — uploads survive redeploys)
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional root folder prefix inside your Cloudinary account (default: ninja-era)
# CLOUDINARY_FOLDER=ninja-era

# S3 / Cloudflare R2 (optional alternative; preferred for very large game builds > Cloudinary limits)
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Prefer private buckets + signed URLs. Avoid permanent public CDN for private resources.
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=true
# Aliases also accepted: R2_BUCKET, R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_PUBLIC_BASE_URL

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
OAUTH_CALLBACK_BASE=http://localhost:3001
# Behind Render/Railway TRUST_PROXY defaults on when NODE_ENV=production
# TRUST_PROXY=1
# HOST=0.0.0.0

# Railway production example (set in dashboard, not in this file):
# NODE_ENV=production
# DATABASE_PROVIDER=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# CORS_ORIGIN=https://ninjaera.up.railway.app
# FRONTEND_URL=https://ninjaera.up.railway.app
# OAUTH_CALLBACK_BASE=https://ninjaera.up.railway.app
# JWT_SECRET=<strong-secret>
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# TURN / WebRTC (required for reliable screen share & calls across NATs in production)
# Free options: Metered.ca, Twilio, self-hosted coturn
# TURN_URLS=turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Optional STUN override (defaults to Google STUN)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Or full JSON override:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:host:3478","username":"u","credential":"p"}]

# ── Email (configurable provider) ───────────────────────────────────────────
# Master switch (default false). When false: no SMTP/Resend connect, no verify,
# no outbound mail. Calls / WebRTC / sockets never touch the mail subsystem.
EMAIL_ENABLED=false
# Opt-in SMTP/API probe on process start (only when EMAIL_ENABLED=true).
# MAIL_VERIFY_ON_STARTUP=false
MAIL_FROM_NAME=Ninja Era
MAIL_FROM_ADDRESS=softfuture28@gmail.com

# RECOMMENDED on Railway: Resend HTTP API (port 443 — no SMTP ports, no timeouts).
# When RESEND_API_KEY is set the app sends via https://api.resend.com/emails.
# SMTP_PROVIDER=resend
# RESEND_API_KEY=<Resend API key>
# MAIL_FROM_ADDRESS=noreply@your-verified-domain.com
#
# Force SMTP even when a Resend key is present:
# MAIL_TRANSPORT=smtp
#
# Resend over SMTP instead of HTTP:
# SMTP_PROVIDER=resend
# SMTP_USER=resend
# SMTP_PASS=<Resend API key>
#
# Other SMTP presets (host/port auto-filled): sendgrid | mailgun | ses | brevo | gmail
# SMTP_PROVIDER=sendgrid
# SMTP_USER=apikey
# SMTP_PASS=<SendGrid API key>

# Gmail (local / when outbound SMTP to Google works):
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Force IPv4 DNS+connect (default). Set 0/auto for dual-stack.
SMTP_IP_FAMILY=4
# SMTP_SECURE=true   # only for port 465; port 587 uses STARTTLS (requireTLS)
# Email verification gate for signup/login (default: false = create account immediately).
# Set to true to restore pending registration + verification email workflow.
EMAIL_VERIFICATION_REQUIRED=false
# Extra trusted signup domains (comma-separated), merged with the built-in provider list
# (Gmail, Outlook/Hotmail/Live/MSN, Yahoo, Proton, iCloud, AOL, Zoho, Fastmail, Tutanota).
# TRUSTED_EMAIL_DOMAINS=company.com,partner.org
# EMAIL_VERIFY_TTL_MS=900000
# EMAIL_RESEND_COOLDOWN_MS=60000
# EMAIL_RESEND_MAX_PER_HOUR=8
# PASSWORD_RESET_TTL_MS=1200000
# PASSWORD_RESET_RESEND_COOLDOWN_MS=60000
# EMAIL_BRAND_LOGO_URL=https://res.cloudinary.com/nitb8mqu/image/upload/v1784207614/logo_tgwmkv.png
# EMAIL_DEV_CONSOLE=true   # local only: skip SMTP (never logs codes; never in production)

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers → OAuth Apps)
# Authorization callback URL: {OAUTH_CALLBACK_BASE}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
