# Frontend environment (Vite)
# Copy to `.env` / `.env.local` and fill in values as needed.

# ── Desktop backend URLs (also read by electron-vite dev proxy) ──
# Development: local backend when running `npm run desktop:dev` or `npm run dev`
NINJA_BACKEND_URL_DEV=http://localhost:3001
# Production: hosted backend used automatically in packaged desktop builds
NINJA_BACKEND_URL_PROD=https://ninjaera.up.railway.app

# Optional: force a specific backend URL (overrides automatic dev/prod selection)
# NINJA_BACKEND_URL=https://ninjaera.up.railway.app

# Optional: signup page opened in the system browser (defaults to production site)
# NINJA_SIGNUP_URL=https://ninjaera.up.railway.app/#/signup

# Optional: website origin for OAuth callback interception
# NINJA_WEBSITE_URL=https://ninjaera.up.railway.app

# ── Social footer links ──
# Leave blank to keep the footer icon in the "not configured" state.
VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com
VITE_SOCIAL_X_URL=https://x.com
VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com
VITE_SOCIAL_WHATSAPP_URL=https://wa.me/818014887319

# Optional: message page window size (default 50, max 100)
# VITE_MESSAGE_PAGE_SIZE=50
